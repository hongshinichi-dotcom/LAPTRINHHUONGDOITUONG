using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace QuanLyChiTieu
{
    internal class Category : Entity
    {
        private string _name; 
        public Category(int id) : base(id)
        {
            _name = "";
        }

        public void SetName(string name)
        {
            name = TrimSafe(name);
            if (name.Length == 0)
                throw new Exception("Ten danh muc khong duoc rong.");
            _name = name;
        }
        public string GetName()
        {
            return _name;
        }

        public void PrintCategory()
        {
            Console.WriteLine("Id = " + GetId() + " | " + _name);
        }

        private string TrimSafe(string s)  
        {
            if (s == null)
                return "";
            return s.Trim();
        }
    }
}

